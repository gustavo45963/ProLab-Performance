# Copia para .env e ajusta conforme o ambiente.
# Sem DATABASE_URL a app usa SQLite em ./data/prolab.sqlite (zero configuração).

# PostgreSQL (Render):
# DATABASE_URL=postgres://user:pass@host:5432/prolab

# MySQL local (XAMPP/WAMP):
# DATABASE_URL=mysql://root@127.0.0.1:3306/prolab

# local | production (controla exibição de erros)
APP_ENV=local
